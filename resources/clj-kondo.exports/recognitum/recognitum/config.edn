{:hooks {:analyze-call {recognitum.core/defproven    hooks.recognitum/defproven
                        recognitum.core/defchecks    hooks.recognitum/defchecks
                        recognitum.core/defcopy      hooks.recognitum/defcopy
                        recognitum.core/defconcern   hooks.recognitum/defconcern
                        recognitum.core/fetch        hooks.recognitum/body-read

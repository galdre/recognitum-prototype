{:paths ["src"]

 :deps {org.clojure/clojure {:mvn/version "1.12.5"}
        potemkin/potemkin   {:mvn/version "0.4.9"}}

 :aliases
 {;; The example model (prototype.heist) and the demo scripts.
  ;;   clojure -M:dev -e "(require 'prototype.demo)(prototype.demo/run)"
  :dev {:extra-paths ["dev"]}

  ;; Benchmark: the library against the same validation written by hand.
  ;;   clojure -M:bench -e "(require 'prototype.bench)(prototype.bench/run)"
  :bench {:extra-paths ["dev" "bench"]
          :extra-deps {criterium/criterium {:mvn/version "0.4.6"}}}

  ;;   clojure -X:test
  ;; prototype.validated-record-test  reads, writes, merge, dissoc
  ;; prototype.draft-test             drafts, drafting, and what seal guarantees
  ;; prototype.audit-test             the invariant :keys audit
  :test {:extra-paths ["dev" "test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :exec-fn cognitect.test-runner.api/test}

  ;; The same suite with *audit-invariant-keys* on, so every type it constructs is checked
  ;; for invariants that read keys they do not declare.
  ;;   clojure -X:test-audit
  :test-audit {:extra-paths ["dev" "test"]
               :extra-deps {io.github.cognitect-labs/test-runner
                            {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
               :jvm-opts ["-Dvalidated-record.audit=true"]
               :exec-fn cognitect.test-runner.api/test}}}
